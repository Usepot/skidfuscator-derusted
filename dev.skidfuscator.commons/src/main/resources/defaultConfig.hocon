exempt: [
%%INJECT%%
]

libs: []

stringEncryption {
  type: STANDARD
  enabled: true
  exempt: []
}

numberEncryption {
  enabled: true
  exempt: []
}

intAnnotationEncryption {
  enabled: true
  exempt: []
}

stringAnnotationEncryption {
  enabled: true
  exempt: []
}

exceptionReturn {
  enabled: true
  exempt: []
}

flowCondition {
  enabled: true
  # Guard compression: hash the full 64-bit flow seed through a non-injective
  # (J)I pool so the baked guard constant no longer inverts to a unique seed.
  # Requires seed.wide; force-disabled with a warning otherwise.
  compressing {
    enabled: false
    salt: false
  }
  exempt: []
}

flowException {
  enabled: true
  strength: AGGRESSIVE
  decoyCalls {
    enabled: false
    scope: APPLICATION_AND_EXEMPT
    includeLibraries: false
    maxArgs: 5
  }
  exempt: []
}

flowRange {
  enabled: true
  exempt: []
}

flowFactoryMaker {
  enabled: true
  exempt: []
}

flowSwitch {
  enabled: true
  exempt: []
}

outliner {
  enabled: true
  exempt: []
}

ahegao {
  enabled: true
  exempt: []
}

native: {
  enabled: false
  exempt: []
}

driver: {
  enabled: false
}

# Thread the per-block flow seed as a 64-bit long instead of a 32-bit int.
# Default off => byte-for-byte identical to the legacy int-seed pipeline.
seed: {
  wide: false
}

reference {
  enabled: false
}

fileCrasher: {
  enabled: false
}

classRenamer {
  enabled: false
  type: CUSTOM
  prefix: "skido/"
  chars: [
    "K"
    "oO",
    "o0"
  ]
  depth: 3
}

methodRenamer {
  enabled: false
  type: CUSTOM
  chars: [
    "K"
    "oO",
    "o0"
  ]
  depth: 3
}

fieldRenamer {
  enabled: false
  type: ALPHABETICAL
}
