# Skidfuscator configuration
# Generated by the Gradle configurator. Referenced from build.gradle via
#   skidfuscator { configFile = layout.projectDirectory.file('skidfuscator.hocon') }
# Only non-default settings are written, so this file stays readable.

exempt = [
  "class{^com/github/}"
  "class{^com/jagrosh/}"
  "class{^com/lunarclient/}"
  "class{^com/occlusionculling/}"
  "class{^com/orbitclient/orbitclient/mixins/}"
  "class{^com/orbitclient/orbitloader/}"
  "class{^com/sun/}"
  "class{^dev/}"
  "class{^frog/}"
  "class{^gui/}"
  "class{^io/}"
  "class{^it/}"
  "class{^javassist/}"
  "class{^mapwriter/}"
  "class{^net/}"
  "class{^okhttp3/}"
  "class{^okio/}"
  "class{^org/}"
  "class{^ru/}"
  "class{^the_fireplace/}"
  "class{^wdl/}"
  "class{^TEst}"
  "class{^jghost\\/}"
  "class{Dump}"
  "class{^org\\/jnativehook\\/}"
  "class{^com\\/sun\\/jna\\/}"
]

flowCondition {
  enabled = true
  compressing {
    enabled = true
    salt = true
  }
}

seed {
  wide = true
}

flowException {
  enabled = true
  decoyCalls {
    enabled = true
    includeLibraries = true
  }
}

interproceduralPredicate {
  enabled = true
  dynamicClassPredicates = true
}

tamperProtection {
  enabled = true
  action = SILENT
}

signatureObfuscation {
  enabled = true
  returns = true
  returnThreadKey = true
}

methodCallObfuscation {
  enabled = true
}
